#!/usr/bin/env bash
# Run vndroid generated in the specified BUILDDIR.
#
# This provides the same feature as "ninja run", except that it is possible to
# pass arguments to vndroid.
#
# Syntax: ./run BUILDDIR <vndroid options ...>
if [[ $# = 0 ]]
then
    echo "Syntax: $0 BUILDDIR <vndroid options>" >&2
    exit 1
fi

BUILDDIR="$1"
shift

if [[ ! -d "$BUILDDIR" ]]
then
    echo "The build dir \"$BUILDDIR\" does not exist." >&2
    exit 1
fi

VNDROID_ICON_DIR="app/data" \
VNDROID_SERVER_PATH="$BUILDDIR/server/vndroid-server" \
"$BUILDDIR/app/vndroid" "$@"
