# This file must be sourced from the release scripts directory
WORK_DIR="$PWD/work"
OUTPUT_DIR="$PWD/output"

VERSION="${VERSION:-$(git describe --tags --always)}"

# A release tag must match the version in meson.build, or the app would offer
# the same update forever
if [[ "$VERSION" =~ ^v[0-9]+(\.[0-9]+)*$ ]]
then
    MESON_VERSION="$(sed -n "s/^[[:space:]]*version: *'\([^']*\)'.*/\1/p" ../meson.build | head -n 1)"
    if [[ "$MESON_VERSION" != "${VERSION#v}" ]]
    then
        echo "ERROR: tag $VERSION does not match version '$MESON_VERSION' in meson.build" >&2
        exit 1
    fi
fi
